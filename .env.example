# Prototype needs no secrets. Hosted backend is not configured.
# Never put service-role keys or payment secrets in browser code.
# Standalone Worker only; disabled by default. Set bindings through approved provider setup.
# FOLLOWKIT_API_ENABLED=false
# APP_ORIGIN=https://your-authorized-app-origin
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# No service/admin secret is used for normal account CRUD.
