{
  "name": "followkit-local-archive-probe",
  "main": "tools/worker/archive-probe.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "dev": { "ip": "127.0.0.1", "port": 8791 },
  "services": [{
    "binding": "ARCHIVE",
    "service": "followkit-deletion-archive",
    "entrypoint": "DeletionArchive",
    "remote": true
  }]
}
